{
  "name": "Verxl",
  "short_name": "Verxl",
  "description": "Verxl — the clearing layer for AI inference. Chat, playground, registry and API in one workspace.",
  "id": "/chat?app=1",
  "start_url": "/chat?app=1",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
